# ==============================================================================
# memorIA - Environment Variables Configuration
# ==============================================================================

# Supabase Configuration
# Obtén estas claves en tu panel de Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# Google AI Studio (Gemini Flash para memorIA Quick-Add)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu-gemini-api-key

# URL base de la aplicación en producción (Vercel)
NEXT_PUBLIC_APP_URL=https://memoria-app.vercel.app
