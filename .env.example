# Local development: persistent SQLite, no cloud key required.
MEMORIA_STORAGE=sqlite
# Optional absolute directory on a persistent disk:
# MEMORIA_DATA_DIR=C:/path/to/private/memoria-data

# For a hosted Supabase deployment, use MEMORIA_STORAGE=supabase and fill these
# only in your private .env.local or the hosting provider's environment settings.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
